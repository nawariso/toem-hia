# Copy to .env.local and replace placeholders. Never commit .env.local.
#
# Default: Controlled Local Development Mode (Requirement 001-B).
# No Supabase project, email provider, OTP, or cloud account is required.
#
#   LOCAL AUTH IS DEVELOPMENT ONLY.
#   IT MUST NEVER BE ENABLED IN PRODUCTION.
#   APP_ENV=production + AUTH_MODE=local is a fatal startup error.

# ---- API --------------------------------------------------------------------
# APP_ENV: development | test | production   (required, no default)
APP_ENV=development
# AUTH_MODE: local | supabase                 (required, no default, no fallback)
AUTH_MODE=local
# MEDIA_MODE: local | disabled                (required, no default)
#   local    = photos on this computer's disk under MEDIA_LOCAL_ROOT.
#              Development/test only: APP_ENV=production + MEDIA_MODE=local is a
#              fatal startup error. No cloud storage account is needed.
#   disabled = media routes answer 503 MEDIA_UNAVAILABLE.
MEDIA_MODE=local
# Absolute path, or relative to the directory the API is started from (the
# repository root in this README). Created if missing; `.local/` is Git-ignored.
# Keep it outside any web-served directory. Ignored when MEDIA_MODE=disabled.
MEDIA_LOCAL_ROOT=.local/media
HTTP_PORT=8080
DATABASE_URL=postgres://toem_hia:replace-with-local-only-password@localhost:5432/toem_hia?sslmode=disable

# ---- Local PostgreSQL (Docker Compose) ---------------------------------------
POSTGRES_USER=toem_hia
POSTGRES_PASSWORD=replace-with-local-only-password
POSTGRES_DB=toem_hia

# ---- Mobile (public values only; embedded in the app bundle) -----------------
# EXPO_PUBLIC_APP_ENV / EXPO_PUBLIC_AUTH_MODE mirror the API values. The app
# additionally refuses local mode in any release (non-__DEV__) bundle.
EXPO_PUBLIC_APP_ENV=development
EXPO_PUBLIC_AUTH_MODE=local
# A phone cannot reach this computer through its own localhost; use the LAN IP.
EXPO_PUBLIC_API_URL=http://YOUR_LAN_IP:8080

# ---- Supabase mode only (DEFERRED to Integration & Pilot Hardening) ----------
# Required only when AUTH_MODE=supabase / EXPO_PUBLIC_AUTH_MODE=supabase.
# The publishable key is designed for clients; never put a secret/service-role key here.
# AUTH_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
# AUTH_AUDIENCE=authenticated
# AUTH_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
# EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
# EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
